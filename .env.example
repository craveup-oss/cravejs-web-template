# Copy to .env.local beside package.json. Public values only; no Crave API key.
# Same four settings as Expo, using Next.js's NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CRAVEUP_API_URL=https://sandbox-api.craveup.com
NEXT_PUBLIC_CRAVEUP_MERCHANT_SLUG=leclerc-bakery-external-demo
NEXT_PUBLIC_CRAVEUP_LOCATION_ID=9d385370-f553-4e7c-85a4-2e4b3e7bcb3f
NEXT_PUBLIC_CRAVEUP_CHECKOUT_ORIGIN=https://checkout.sandbox.order.page

STOREFRONT_PROFILE=standalone-cli
# Theme, assets, locale, timezone and immutable project identity:
# src/config/standalone-settings.ts
# Optional canonical origin override; HTTPS required for production builds.
# STOREFRONT_CANONICAL_ORIGIN=https://order.example.com

# Optional domain-restricted browser Maps key for delivery address search.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# STOREFRONT_DELIVERY_RADIUS_MILES=5

# Hosted deployments instead select hosted-multitenant and use their trusted registry.
# The four standalone merchant/location/checkout settings do not override hosted tenants.
# STOREFRONT_HOSTED_TENANTS_JSON={"store.example.com":{"profile":"hosted-multitenant","tenantId":"tenant-replace-me","projectId":null,"merchantSlug":"replace-me","canonicalOrigin":"https://store.example.com","apiBaseUrl":"https://api.example.com","assetOrigins":[],"checkoutOrigins":["https://checkout.example.com"],"themeId":"base","locale":"en-US","timeZone":"America/Los_Angeles","templateRelease":"0.1.0","configSchemaVersion":"1.0.0","capabilities":{"loyalty":false},"newsletter":{"heading":"Stay in the loop","emailLabel":"Email address","submitLabel":"Subscribe","consentCopy":"Get restaurant news and offers in your inbox.","successMessage":"Thanks for subscribing."}}}
# FIGMA_TOKEN belongs only in .env.figma.local or your shell.
